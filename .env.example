# 复制为 .env 后填入真实值：copy .env.example .env
# 这个文件里只放示例，真实 key 不要提交到 git

# --- 必填 ---
GMAIL_ADDRESS=your-name@gmail.com
DEEPSEEK_API_KEY=sk-your-key-here

# --- 可选（默认值已够用） ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 数据目录 / 数据库 / token 位置，默认都在项目根目录
# AIDE_DATA_DIR=./data
# AIDE_DB_PATH=./data/mail.db
# AIDE_TOKEN_PATH=./data/token.json
# AIDE_CREDENTIALS_PATH=./client_secret_xxx.json

# 模型调用参数
# AIDE_REASONING_EFFORT=none
# AIDE_MODEL_TIMEOUT=90

# 日志级别：DEBUG / INFO / WARNING
# AIDE_LOG_LEVEL=INFO
